# Copy to .env and fill in real values. Never commit .env.
# On Render, every variable below must be added in the service's Environment tab.

# ---------- Runtime ----------
# Controls the `secure` flag on the session cookie. Must be "production" on Render.
NODE_ENV=development

# ---------- Database (Neon Postgres) ----------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---------- JWT ----------
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=15m
REFRESH_JWT_SECRET=your_refresh_jwt_secret
REFRESH_JWT_EXPIRES_IN=1d

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_SECRET=your_google_client_secret
# Must be registered in Google Cloud Console -> Authorised redirect URIs.
#   local      -> http://localhost:8000/auth/google/callback
#   production -> https://elvate.vercel.app/api/backend/auth/google/callback
#                 (goes through the frontend proxy so the cookie is first-party)
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback

# ---------- Email (SMTP) ----------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SENDER=your_email@example.com
EMAIL_PASSWORD=your_email_app_password

# ---------- SMS ----------
SMS_API_URL=http://bulksmsbd.net/api/smsapi
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=your_sms_sender_id

# ---------- Face++ (face login) ----------
FACEPP_API_KEY=your_facepp_api_key
FACEPP_API_SECRET=your_facepp_api_secret

# ---------- Session cookie ----------
# Base64-encoded 32-byte key. MUST be identical to COOKIES_SECRET in the frontend.
# Generate with: openssl rand -base64 32
COOKIES_SECRET=your_base64_cookies_secret

# ---------- Frontend ----------
# Used for CORS, OAuth redirect, email links and Stripe return URLs.
#   local -> http://localhost:3000, production -> https://elvate.vercel.app
FRONTEND_URL=http://localhost:3000

# ---------- ImageKit ----------
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# Stripe Price IDs for the subscription plans
PRICE_1M=price_your_1_month_price_id
PRICE_6M=price_your_6_month_price_id
PRICE_12M=price_your_12_month_price_id
